# =========================================================
# DOT DevOps Team — Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# =========================================================

# ---------------------------------------------------------
# Supabase Public Client (Browser-safe — uses RLS)
# Used by Frontend to record email, college, and notes
# in public.registration_extras on form submission.
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------
# UPI Payment — public (shown in QR code on the client)
# Replace with the real club UPI ID before going live.
# ---------------------------------------------------------
NEXT_PUBLIC_UPI_ID=placeholder@upi
NEXT_PUBLIC_UPI_PAYEE_NAME=DOT_DevOps_Club
